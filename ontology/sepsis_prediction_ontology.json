  "assertion_values": {
    "certainty": ["confirmed", "suspected", "possible", "uncertain", "unknown"],
    "negation": ["true", "false"],
    "temporality": ["current", "historical", "future", "unknown"],
    "status": ["preliminary", "final", "amended", "entered-in-error", "unknown"],
    "mappingMethod": ["structured_rule", "ward_rule", "LLM_ward_mapping", "dictionary", "SNOMED", "SEPON", "LLM", "manual_review", "rule_fallback"],
    "mappingStatus": ["accepted", "pending_review", "unmapped", "rejected"]
  },
  "feature_exclusion_rules": [
    "exclude explicit sepsis diagnosis concepts from predictors",
    "exclude septic shock, disseminated intravascular coagulation and multiple-organ dysfunction diagnosis concepts from predictors",
    "represent pre-cutoff physiologic abnormalities as observations or organ dysfunction evidence, not as outcome diagnoses",
    "retain only baseline or pre-cutoff risk factors as predictor features",
    "exclude observations with effective_time at or after cutoff_time",
    "exclude retrospective discharge diagnosis text from predictor features",
    "retain negated and uncertain findings as assertions, not positive findings",
    "retain treatment observations only when they occurred before cutoff_time"
  ],
  "mapping_policy": {
    "sepon": "reuse an exact SEPON class when the concept exists; otherwise create a local SEPPRED extension and record sepon_parent",
    "snomed_ct": "store the SNOMED CT concept identifier when available; never replace the original Chinese term",
    "fhir": "represent each patient-timepoint record as a ClinicalObservation using Observation-like fields",
    "llm": "Qwen may propose mappings, but low-confidence mappings remain pending manual review; unmapped evidence must be represented as UnmappedObservation",
    "support_requirement": "a concept can be in the full ontology without local data support, but it cannot become a model feature until data_supported=true"
  },
  "llm_mapping_contract": {
    "input": ["source_table", "visit_no", "record_time", "raw_code", "raw_text", "raw_value", "unit"],
    "output": [
      "concept_id",
      "concept_label",
      "ontology_branch",
      "value",
      "unit",
      "effective_time",
      "certainty",
      "negation",
      "temporality",
      "source_span",
      "relations",
      "mapping_confidence"
    ],
    "required_rules": [
      "do not infer a positive finding from a negated phrase",
      "do not use diagnosis-after-cutoff information as a feature",
      "preserve raw text and source span for audit",
      "preserve numeric value and unit for observations",
      "return unknown instead of inventing a concept"
    ]
  },
  "data_sources": {
    "vital_signs": "Dataset/icu_vital_signs_HID0101.csv",
    "laboratory": "Dataset/lab_reportdet_HID0101.csv",
    "ward_rounds": "Dataset/icu_ward_rounds_HID0101.csv",
    "diagnosis": "Dataset/icu_diagnosis_HID0101.csv",
    "encounter": "Dataset/baseinfo.csv"
  }
