{
  "ontology_id": "SEPPRED",
  "name": "Ontology for Temporal Early Prediction of Sepsis",
  "name_zh": "脓毒症时序早期预测本体",
  "version": "0.8.0",
  "status": "draft",
  "purpose": "Represent diagnosis-free, pre-cutoff clinical observations and temporal evidence for early prediction of sepsis.",
  "scope": {
    "target": "patient encounter at prediction time t",
    "feature_rule": "only observations whose effective_time is earlier than cutoff_time are model features",
    "diagnosis_rule": "sepsis diagnosis concepts are outcome evidence and must be excluded from predictor features after cutoff",
    "time_rule": "preserve clinical effective time separately from documentation time",
    "outcome_separation": "the final sepsis label is dataset supervision metadata, not an input ontology class"
  },
  "external_ontologies": {
    "SEPON": {
      "uri": "http://www.semanticweb.org/zchero/ontologies/2023/11/SepsisOntology#",
      "file": "ontology/SEPON1.ofn",
      "role": "sepsis domain concepts, symptoms, biomarkers, etiology and relations"
    },
    "SNOMED_CT": {
      "uri": "http://snomed.info/sct/",
      "role": "clinical concept identifiers, synonyms and hierarchy"
    },
    "FHIR": {
      "uri": "http://hl7.org/fhir/",
      "role": "clinical observation and provenance information model"
    },
    "ICD10": {
      "uri": "http://hl7.org/fhir/sid/icd-10/",
      "role": "local diagnosis code mapping and outcome definition"
    }
  },
  "namespaces": {
    "seppred": "https://example.org/sepsis-prediction/",
    "sepon": "http://www.semanticweb.org/zchero/ontologies/2023/11/SepsisOntology#",
    "snomed": "http://snomed.info/sct/",
